<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerAddresses</key>
                <array>
                    <string>1.1.1.1</string>
                    <string>8.8.8.8</string>
                </array>
                <key>ServerURL</key>
                <string>https://cloudflare-dns.com/dns-query</string>
            </dict>
            <key>PayloadDescription</key>
            <string>Kích hoạt tính năng Antiband Fix, mã hóa gói tin và tối ưu hóa mạng để chống quét thiết bị.</string>
            <key>PayloadDisplayName</key>
            <string>DNS Antiband & Tối Ưu Mạng</string>
            <key>PayloadIdentifier</key>
            <string>com.mquang.dnssettings</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>12345678-ABCD-EF01-2345-6789ABCDEF01</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
    </array>
    <key>PayloadDescription</key>
    <string>Ứng dụng Magic App cung cấp hệ thống tối ưu mạng, Fix Band và bảo vệ tài khoản an toàn tuyệt đối trên iOS.</string>
    <key>PayloadDisplayName</key>
    <string>Magic App - DNS Fix Antiband</string>
    <key>PayloadIdentifier</key>
    <string>com.mquang.profile.root</string>
    <key>PayloadOrganization</key>
    <string>MQuang VIP</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>87654321-DCBA-FE10-5432-1098FEDCBA09</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
